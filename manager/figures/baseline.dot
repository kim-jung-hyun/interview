// 기준선 — 네 진영과 세 분리선
// 이 인터뷰 전체의 기준선. 모든 역할 질문은 이 그림으로 답한다.
// 근거: 05. MS RAI v2 「역할별 핵심 Accountability」 + lifecycle 운영모델 표의 구조
// 정본: manager/02_structure.md §0  (내용 변경 금지)
digraph baseline {
  rankdir=LR; bgcolor="white"; nodesep=0.45; ranksep=0.9; newrank=true;
  node [shape=box, style="rounded,filled", fillcolor="white", color="#333333",
        fontname="Noto Sans CJK KR", fontsize=12, width=2.5, height=1.0];
  edge [fontname="Noto Sans CJK KR", fontsize=10, color="#333333", penwidth=1.4];

  GRC  [label="기준\n\nAI GRC\n★ 내 자리 = 「기준 제공자」\nStaff AI Security Governance Engineer", style="filled,bold", fillcolor="#e0e0e0", penwidth=2];
  DEV  [label="구현\n\nDevelopment\nAI System Owner"];
  ASR  [label="판정  =  Assurance\n\nControl Owner · QE/TEVV\nRelease Approver · Internal Audit\n실행 · 모니터링 · 시험 · 승인 · 감사",
        style="filled,bold", fillcolor="#f0f0f0", width=3.4, penwidth=2];
  ACC  [label="수용\n\nRisk Owner\nBusiness Owner"];

  GRC -> DEV [label="① 개발팀용 기준·가이드\n규제 requirement → SW 구조"];
  DEV -> ASR [label="구현된 통제와 evidence"];
  ASR -> ACC [label="판정 결과와 residual risk"];
  GRC -> ASR [label="② evidence·audit 가능 구조 요건", style=bold, constraint=false];

  // 분리선
  node [shape=plaintext, style="", fillcolor="", fontsize=10, width=0, height=0];
  S1 [label="분리선 ①\n만든 사람이\n판정하지 않는다"];
  S2 [label="분리선 ②\n판정한 사람이\n위험을 수용하지 않는다"];
  S3 [label="분리선 ③\n기준을 만든 사람이\n그 기준으로 판정하지 않는다"];

  { rank=same; DEV; S1; ASR; S2; ACC; }
  DEV -> S1 [style=invis]; S1 -> ASR [style=invis];
  ASR -> S2 [style=invis]; S2 -> ACC [style=invis];
  GRC -> S3 [style=dotted, arrowhead=none, penwidth=1.2];
  S3 -> ASR [style=dotted, arrowhead=none, penwidth=1.2];
  { rank=same; GRC; S3; }
}
