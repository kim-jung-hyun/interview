// AI System 구조 — Model · Harness · Policy · Evidence · Test · E2E Test
// 근거: 03. NIST Profile §6 Target Control Architecture / 04. AWS SRA Agentic
// 정본: manager/07_system_architecture.md §2·§3  (내용 변경 금지)
digraph architecture {
  rankdir=TB; splines=polyline; nodesep=0.3; ranksep=0.4; bgcolor="white";
  node [shape=box, style="rounded,filled", fillcolor="white", color="#333333",
        fontname="Noto Sans CJK KR", fontsize=11, width=2.9, height=0.45];
  edge [fontname="Noto Sans CJK KR", fontsize=9, color="#333333"];

  IN  [label="Identity / Session Context", shape=box, style="filled", fillcolor="#f5f5f5"];
  EXT [label="외부 데이터 수집 (검색·RAG·도구결과)\n◆ 신뢰 등급을 여기서 선언", style="filled,dashed", fillcolor="#f0f0f0"];
  CTX [label="Prompt / Context Builder"];

  M   [label="1  MODEL\naction 후보 제안", style="rounded,filled,bold"];
  H   [label="2  HARNESS\nschema · parameter 검증", style="rounded,filled,bold"];
  P   [label="3  POLICY (PDP)\nidentity·tool·resource·parameter·context", style="filled,bold", shape=hexagon, fillcolor="#e8e8e8", width=3.4];
  G   [label="4  GUARDRAIL (PEP)\nruntime 집행", style="rounded,filled,bold"];
  T   [label="Tool 실행 (메일·캘린더·DB)"];

  DENY [label="거부 + 기록", shape=box, style="filled", fillcolor="#f5f5f5", width=1.6];
  HUM  [label="사람 승인\napprover 신원 · 승인 기록", shape=box, style="filled,bold", fillcolor="#e0e0e0", width=2.4];

  EV  [label="5  EVIDENCE\n입력 · context · 정책버전 · 결정 · 승인 · 실행결과를 연결해 기록",
       shape=box3d, style="filled", fillcolor="#f0f0f0", width=5.2];
  TS  [label="6  TEST\n요소별 명세 준수", shape=note, style="filled", fillcolor="#f5f5f5", width=2.2];
  E2E [label="6  E2E TEST\n선언된 통제가 실제로 집행되는가\n= 정의·집행 불일치(drift) 검출",
       shape=note, style="filled,bold", fillcolor="#e8e8e8", width=3.2];

  IN -> EXT -> CTX -> M -> H -> P;
  P -> G    [label="ALLOW"];
  P -> DENY [label="DENY"];
  P -> HUM  [label="REQUIRE_APPROVAL\n(PIPA 자동화된 결정)"];
  HUM -> G  [label="승인"];
  G -> T;

  M -> EV [style=dotted, arrowhead=open];
  H -> EV [style=dotted, arrowhead=open];
  P -> EV [style=dotted, arrowhead=open, label="정책 버전"];
  G -> EV [style=dotted, arrowhead=open];
  T -> EV [style=dotted, arrowhead=open];
  HUM -> EV [style=dotted, arrowhead=open];

  TS -> H [style=dashed, arrowhead=vee, constraint=false];
  E2E -> M [style=dashed, arrowhead=vee, constraint=false, label="입력 주입"];
  E2E -> T [style=dashed, arrowhead=vee, constraint=false, label="실행 관측"];
  { rank=same; TS; E2E; }
  { rank=same; DENY; G; HUM; }
}
